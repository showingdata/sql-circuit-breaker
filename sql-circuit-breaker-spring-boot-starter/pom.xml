<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.showingdata.starter.framework</groupId>
        <artifactId>sql-circuit-breaker-parent</artifactId>
        <version>1.0.6</version>
    </parent>

    <artifactId>sql-circuit-breaker-spring-boot-starter</artifactId>
    <name>sql-circuit-breaker-spring-boot-starter</name>

    <dependencies>

        <dependency>
            <groupId>io.github.showingdata.starter.framework</groupId>
            <artifactId>sql-circuit-breaker-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
            仅需 MyBatis core（拦截器工作在 Executor 层，不依赖 MP）。
            provided：由业务系统引入，兼容 mybatis-spring-boot-starter 和 mybatis-plus-boot-starter。
        -->
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            Guava 作为 SDK 的编译和运行时依赖传递给业务方，确保开箱即用，
            避免业务方 classpath 缺失 Guava 导致 NoClassDefFoundError。
            版本由 parent 的 dependencyManagement 统一管控。
        -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>

    </dependencies>
</project>
